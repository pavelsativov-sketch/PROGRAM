# Copy to .env for local dev

ENV=dev

# AI provider: free | anthropic | openai | gemini
# Рекомендуется gemini — бесплатный ключ в Google AI Studio, щедрые лимиты
# и отличное качество на русском. Если ключ не задан, бот мягко откатывается
# на провайдер `free` (Pollinations.ai, без ключа), чтобы работать «из коробки».
AI_PROVIDER=gemini
FREE_MODEL=openai

# Anthropic Claude (рекомендуется для prod). https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (РЕКОМЕНДУЕТСЯ). Бесплатный ключ за 1 минуту:
# https://aistudio.google.com/apikey
# Для большего объёма запросов в день можно поставить gemini-2.5-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp bridge
WA_BRIDGE_URL=http://localhost:3001
WA_BRIDGE_SECRET=change_me

# Instagram (лучше задавать в UI → Settings)
IG_USERNAME=
IG_PASSWORD=

# DB
DATABASE_URL=sqlite:///./data.db

# JWT
JWT_SECRET=change_this_in_prod_please_min_32_chars_long_secret
JWT_ACCESS_MINUTES=60

# Шифрование секретов в БД (Fernet key). Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# В dev можно оставить пустым — данные будут в открытом виде.
SECRET_ENCRYPTION_KEY=

# CORS (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Биллинг
SHOP_NAME=Flower Shop
SHOP_CURRENCY=RUB
PUBLIC_BASE_URL=http://localhost:8000
