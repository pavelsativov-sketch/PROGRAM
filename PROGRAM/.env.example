# docker-compose .env
DOMAIN=localhost
ENV=prod

# Postgres
DB_USER=floral
DB_PASSWORD=change_me_strong_password
DB_NAME=floral

# JWT — сгенерируйте: openssl rand -hex 48
JWT_SECRET=change_me_min_32_chars_random

# Шифрование секретов в БД (AI ключи). Fernet.
# Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# WA bridge — сгенерируйте: openssl rand -hex 32
WA_BRIDGE_SECRET=change_me_wa_bridge_random

# Подпись pay-ссылок — сгенерируйте: openssl rand -hex 32. Если пусто, деривируется из JWT_SECRET.
PAY_SIGNING_KEY=

# CORS — разделяйте запятыми
CORS_ORIGINS=https://your-domain.tld,http://localhost:5173

# Публичный базовый URL для ссылок на счета
PUBLIC_BASE_URL=https://your-domain.tld

# AI провайдеры (опционально, можно задавать в UI магазина)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
